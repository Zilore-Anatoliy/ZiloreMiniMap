# Auto-detect text files
* text=auto

# Documentation & GitHub config (LF)
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf

# C# sources & project files
*.cs text diff=csharp
*.csproj text
*.sln text eol=crlf

# Windows PowerShell, CMD & Inno Setup scripts (CRLF)
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
*.iss text eol=crlf

# Binary assets (never modify line endings)
*.ico binary
*.png binary
*.bmp binary
*.jpg binary
*.bin binary
*.ttf binary
*.wav binary
*.ogg binary
*.mp3 binary
*.exe binary
*.dll binary
*.zip binary
*.p7s binary
*.cer binary
